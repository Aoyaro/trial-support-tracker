# Server
PORT=3000
# Where the SQLite file lives (default: ./data/trial.db)
DB_PATH=./data/trial.db
# Public base URL used to build technician magic links.
# Leave empty for local dev (built from the request host).
# On Render set e.g.: BASE_URL=https://trial-support-tracker.onrender.com
BASE_URL=

# --- WhatsApp Cloud API (optional; trial works without it) ---
# Phone Number ID from your WhatsApp Business Account (Meta dashboard).
WHATSAPP_PHONE_NUMBER_ID=
# Permanent access token (system user token — never commit the real one).
WHATSAPP_TOKEN=
